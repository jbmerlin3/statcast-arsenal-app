<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jonathanmerlin.arsenal-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jonathanmerlin/statcast-arsenal-app/scripts/watchdog.sh</string>
  </array>

  <!-- Hourly whenever the machine is awake; also fires shortly after load -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>/Users/jonathanmerlin/statcast-arsenal-app</string>

  <!-- gh is in /opt/homebrew/bin, which launchd's default PATH lacks -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/jonathanmerlin/statcast-arsenal-app/logs/watchdog.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/jonathanmerlin/statcast-arsenal-app/logs/watchdog.err</string>
</dict>
</plist>
